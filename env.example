# Recruiter Workflow Fragmentation API - Environment Variables

# Application Settings
APP_NAME="Recruiter Workflow Fragmentation API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server Settings
HOST="0.0.0.0"
PORT=8000

# Database Settings
# SQLite (default)
DATABASE_URL="sqlite:///./recruiter_workflow.db"
DATABASE_ECHO=False

# PostgreSQL example
# DATABASE_URL="postgresql://username:password@localhost:5432/recruiter_workflow"

# Security Settings
SECRET_KEY="your-secret-key-here"
ALLOWED_ORIGINS=["*"]
API_KEY="your-api-key-here"

# Rate Limiting
RATE_LIMIT=100
RATE_LIMIT_WINDOW=60

# LLM Provider: "ollama" (local, free) or "openai" (cloud, requires API key)
LLM_PROVIDER="ollama"

# OpenAI Settings (used when LLM_PROVIDER=openai)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-3.5-turbo"

# Ollama Settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# File Storage Settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880  # 5MB

# Logging Settings
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Agent Settings
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=True